# Wazuh Single-Node Docker Deployment Environment Template
# Copy this file to .env and configure strong passwords for production / local lab use.
# NEVER commit the active .env file to version control.

# Wazuh Version Tag (Official release)
WAZUH_VERSION=4.14.9
CERT_TOOL_VERSION=0.0.4

# Wazuh Indexer OpenSearch JVM Heap (1 GB min for lab; adjust if resources allow)
INDEXER_JAVA_OPTS=-Xms1g -Xmx1g

# Wazuh Indexer Admin Credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_INDEXER_STRONG_PASS_123!

# Wazuh Manager API Credentials
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_API_STRONG_PASS_123!

# Wazuh Dashboard Internal OpenSearch User
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Bind IP Address (127.0.0.1 for local isolation, preventing public exposure)
BIND_IP=127.0.0.1
